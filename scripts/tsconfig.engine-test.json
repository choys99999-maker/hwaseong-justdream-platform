{
  // 엔진 회귀 테스트는 브라우저 없이 Node 에서 돌린다.
  // 앱 빌드(tsconfig.app.json)와 달리 CommonJS 로 뽑아야 확장자 없는 import 가 그대로 동작한다.
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "commonjs",
    "moduleResolution": "node10",
    "ignoreDeprecations": "6.0",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["node"],
    "strict": true,
    "noEmitOnError": true,
    "outDir": "../.tmp-engine-test",
    "rootDir": ".."
  },
  "include": ["excel-engine-test.ts"]
}
