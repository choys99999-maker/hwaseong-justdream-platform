# 카카오맵 JavaScript SDK 앱 키
# https://developers.kakao.com > 내 애플리케이션 > 앱 키 > JavaScript 키
#
# 두 가지가 모두 맞아야 카카오 지도가 뜬다.
#   1) 이 키를 채운 뒤 개발 서버를 다시 시작한다 (Vite 는 실행 시점에만 .env 를 읽는다)
#   2) 카카오 개발자 사이트 [플랫폼 > Web] 에 **실행 중인 도메인을 등록**한다
#      (localhost:5173, Cloudflare Pages 도메인, 사내 프록시 도메인을 각각 등록해야 한다)
#
# 도메인을 등록하지 않으면 sdk.js 는 200 으로 내려오지만 이후 초기화가 조용히 멈춘다 —
# 이 경우 8초 뒤 실패로 처리하고 저장소에 포함된 경계 데이터로 그린 기본 지도로 자동 전환한다.
# 즉 비워 두어도 화면이 죽지는 않는다. 도로·지명 배경만 없어진다.
VITE_KAKAO_MAP_JAVASCRIPT_KEY=

# Supabase 중앙 저장소 — 자료 관리와 집계 화면의 source of truth.
# 비워두면 해당 화면들이 "중앙 저장소가 설정되지 않았습니다" 안내만 띄운다.
# (Cloudflare Pages 에서도 같은 이름으로 환경변수를 등록한다)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
