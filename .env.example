# 카카오맵 JavaScript SDK 앱 키
# https://developers.kakao.com > 내 애플리케이션 > 앱 키 > JavaScript 키
# 카카오 개발자 사이트의 [플랫폼 > Web] 에 실행 도메인을 등록해야 지도가 로드됩니다.
VITE_KAKAO_MAP_JAVASCRIPT_KEY=

# Supabase 중앙 저장소 — 자료 관리와 집계 화면의 source of truth.
# 비워두면 해당 화면들이 "중앙 저장소가 설정되지 않았습니다" 안내만 띄운다.
# (Cloudflare Pages 에서도 같은 이름으로 환경변수를 등록한다)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
